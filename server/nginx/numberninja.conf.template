# FEAT-12: BrainBubblz API site for the droplet's existing nginx.
# nginx/render.sh fills in the host, the certificate name and the optional
# legacy host (FEAT-20: the old host, kept for installed apps; lines naming
# it are dropped when it is empty), and install.sh writes the
# result to /etc/nginx/sites-available/numberninja.conf. It is the only
# nginx file the deploy touches. Certificate: one certbot --webroot
# certificate for both names into /var/www/numberninja-acme (install.sh;
# renewals reload nginx).

# FEAT-20: the Google return page opens the app that asked. Apps built for the
# old host are the old app id with numberninja://; the new host gets
# brainbubblz://.
map $host $brainbubblz_app_scheme {
    default brainbubblz;
    ${SERVER_LEGACY_HOSTNAME} numberninja;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_HOSTNAME};
    server_name ${SERVER_LEGACY_HOSTNAME};

    location /.well-known/acme-challenge/ {
        root /var/www/numberninja-acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # "listen ... http2" rather than "http2 on;": stock Ubuntu/Debian nginx
    # (1.18-1.24) has no http2 directive; 1.25.1+ only warns.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${SERVER_HOSTNAME};
    server_name ${SERVER_LEGACY_HOSTNAME};

    ssl_certificate /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;

    # Bank files (FEAT-15) are up to 20 MB.
    client_max_body_size 25m;

    # Admin UI is not public: open it through an SSH tunnel (server/README.md).
    location /_/ {
        return 404;
    }
    # Google sign-in: PocketBase's /api/oauth2-redirect sends the browser to
    # /_/#/auth/oauth2-redirect-success (or -failure). Answer that one page
    # here so the parent sees a result, not a 404; the admin UI's own files
    # under /_/ stay 404. No dollar signs in the body (nginx variables).
    location = /_/ {
        default_type text/html;
        add_header Cache-Control "no-store" always;
        return 200 '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BrainBubblz</title></head><body style="font-family:sans-serif;text-align:center;padding:48px 16px"><h1 id="t">Signed in</h1><p id="m">Close this tab to go back to BrainBubblz.</p><script>if (location.hash.indexOf("failure") >= 0) { document.getElementById("t").textContent = "Sign-in did not finish"; document.getElementById("m").textContent = "Close this tab and try again in BrainBubblz."; }</script></body></html>';
    }
    location = /_ {
        return 404;
    }

    # Google sign-in returns here (the app's redirect URL, FEAT-13). The page
    # hands state and code back to the app through brainbubblz://signin/google
    # (numberninja:// on the legacy host, map above), which closes the tab; the
    # app finishes with auth-with-oauth2. A button covers a browser that won't
    # open the app without a tap. The only dollar sign in the body is the
    # scheme variable (nginx fills it in).
    location = /signin/google {
        default_type text/html;
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        return 200 '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BrainBubblz</title></head><body style="font-family:sans-serif;text-align:center;padding:48px 16px"><h1>Back to BrainBubblz</h1><p><a id="go" style="display:inline-block;padding:16px 32px;font-size:20px;background:#2f6fde;color:#fff;border-radius:12px;text-decoration:none" href="$brainbubblz_app_scheme://signin/google">Open BrainBubblz</a></p><script>var link = "$brainbubblz_app_scheme://signin/google" + location.search; document.getElementById("go").href = link; location.replace(link);</script></body></html>';
    }

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # PocketBase reads the client IP from X-Real-IP (settings migration:
        # trustedProxy), so rate limits are per client, not per nginx.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Realtime is server-sent events: keep the stream open, unbuffered.
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 360s;
    }
}
